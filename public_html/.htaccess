# Form Management System - Front Controller
# 共有レンタルサーバー想定

Options -Indexes

# PHPファイルとして解釈する拡張子（念のため）
AddType application/x-httpd-php .php

# UTF-8 を既定に
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # /app/ 以下と /uploads/ への直接アクセスを禁止（サブの.htaccessでも防御）
    RewriteRule ^app/ - [F,L]

    # 既存のファイル/ディレクトリはそのまま
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /admin/* は admin/index.php へ
    RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

    # それ以外は index.php へ
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ドットファイル等の保護
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|sql|log|ini|sh)$">
    Require all denied
</FilesMatch>
