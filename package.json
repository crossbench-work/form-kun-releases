{
  "name": "form-kun",
  "private": true,
  "scripts": {
    "build:css": "sass src/assets/scss/public.scss:dist/assets/css/public.css src/assets/scss/admin.scss:dist/assets/css/admin.css --style=expanded --no-source-map",
    "build": "node scripts/build-dist.mjs",
    "env:local": "node scripts/deploy-env.mjs local",
    "release": "npm run build && node scripts/build-release.mjs",
    "publish:update": "node scripts/publish-update.mjs",
    "watch:css": "sass --watch src/assets/scss:dist/assets/css --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  },
  "version": "1.0.0"
}
