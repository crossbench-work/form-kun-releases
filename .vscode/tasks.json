{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "form-kun: PHP dev server (8080)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev-server.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "php",
        "pattern": { "regexp": "^(.*)$", "file": 1, "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Development Server \\(.*\\) started"
        }
      }
    }
  ]
}
